generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CLIENT
  WORKER
  ADMIN
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum VerificationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}
enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  firstName String
  lastName String
  email String @unique
  passwordHash String
  phone String @default("")
  role Role @default(CLIENT)
  status AccountStatus @default(ACTIVE)
  avatarUrl String @default("/images/avatar.svg")
  sessionVersion Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  client ClientProfile?
  worker WorkerProfile?
  notifications Notification[]
  auditLogs AuditLog[]
  reviews VerificationReview[]
  resetTokens ResetToken[]
  @@index([role, status])
}
model ClientProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  city String @default("")
  postcode String @default("")
  address String @default("")
  requests CareRequest[]
  favourites Favourite[]
}
model WorkerProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  slug String @unique
  profession String
  jobTitle String @default("")
  introduction String @default("")
  biography String @default("")
  experienceYears Int @default(0)
  hourlyRate Decimal @default(20) @db.Decimal(8,2)
  city String @default("")
  postcode String @default("")
  address String @default("")
  dateOfBirth String @default("")
  travelRadius Int @default(10)
  languages String[] @default(["English"])
  specialisations String[] @default([])
  registrationNumber String @default("")
  preferredLocation String @default("")
  liveIn Boolean @default(false)
  overnight Boolean @default(false)
  isListed Boolean @default(true)
  verificationStatus VerificationStatus @default(DRAFT)
  onboardingStep Int @default(1)
  submittedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  qualifications WorkerQualification[]
  skills WorkerSkill[]
  services WorkerService[]
  availability WorkerAvailability[]
  documents VerificationDocument[]
  reviews VerificationReview[]
  requests CareRequest[]
  favourites Favourite[]
  @@index([verificationStatus, isListed, city])
}
model WorkerQualification {
  id String @id @default(uuid()) @db.Uuid
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  qualificationName String
  institution String @default("")
  yearCompleted Int @default(2020)
}
model WorkerSkill {
  id String @id @default(uuid()) @db.Uuid
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  skillName String
}
model WorkerService {
  id String @id @default(uuid()) @db.Uuid
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  serviceType String
}
model WorkerAvailability {
  id String @id @default(uuid()) @db.Uuid
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  dayOfWeek Int
  startTime String
  endTime String
  isAvailable Boolean @default(true)
  @@unique([workerId, dayOfWeek])
}
model VerificationDocument {
  id String @id @default(uuid()) @db.Uuid
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  documentType String
  privateStorageKey String
  originalFileName String
  mimeType String
  reviewStatus String @default("UPLOADED")
  uploadedAt DateTime @default(now()) @db.Timestamptz(3)
}
model VerificationReview {
  id String @id @default(uuid()) @db.Uuid
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  reviewedBy String @db.Uuid
  reviewer User @relation(fields:[reviewedBy], references:[id])
  previousStatus VerificationStatus
  newStatus VerificationStatus
  notes String
  reviewedAt DateTime @default(now()) @db.Timestamptz(3)
}
model CareRequest {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client ClientProfile @relation(fields:[clientId], references:[id])
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id])
  careType String
  requestedDate DateTime @db.Timestamptz(3)
  startTime String
  durationHours Int
  generalLocation String
  description String
  notes String @default("")
  status RequestStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([clientId, status])
  @@index([workerId, status])
}
model Favourite {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client ClientProfile @relation(fields:[clientId], references:[id], onDelete:Cascade)
  workerId String @db.Uuid
  worker WorkerProfile @relation(fields:[workerId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([clientId, workerId])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  type String
  title String
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId, isRead])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields:[actorId], references:[id])
  action String
  entityType String
  entityId String
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model ResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime @db.Timestamptz(3)
}
model RateLimit {
  key String @id
  count Int @default(1)
  windowStart DateTime @default(now()) @db.Timestamptz(3)
}
